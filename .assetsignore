# ── Cloudflare Pages: do NOT publish these as web assets ───────────────
# Anything not on this list ships at https://balthazar.sh/<path>.

# Cloudflare infrastructure
_worker.js
wrangler.toml
.assetsignore
.git
.git/**
.wrangler
.wrangler/**
*.map

# Python source — the truth-kernel package lives in this repo as code,
# not as web assets. The package is consumed by `pip install`, not by
# the website. Keep all of it off the public deploy.
c
c/**
agent.py
pyproject.toml
requirements.txt
config.example.json
config.json
.env
.env.*

# Heart records and runtime state — never publish even by accident
memory
memory/**
chains
chains/**
nohup.out
*.log

# Backup files from local debugging
*.bak
*.before_*
*.false_positive_*

# Python artifacts
__pycache__
__pycache__/**
*.pyc
*.pyo
.venv
.venv/**
venv
venv/**
build
build/**
dist
dist/**
*.egg-info
*.egg-info/**

# OS / editor noise
.DS_Store
.idea
.idea/**
.vscode
.vscode/**

# README — markdown is fine but we don't need it on the website
README.md

# ── WEIGHT: keep the public book light ────────────────────────────────
# The 4K @2x rasters (~1 MB each, 35 MB total) are NOT referenced by the
# storybook — index.html serves the @1x editions (~175 KB), plenty sharp for
# a painterly book. Keeping @2x off the deploy is the load fix.
plates-vg/*@2x.jpg
# Stroke-capture data + dev studies/previews — generators and experiments,
# never loaded by the book. Big and useless on the public deploy.
*-strokes.json
*-study.html
vangogh-preview.html
vg-preview.html
plates-preview.html
platesA-preview.html
gen-vangogh.mjs
plates
plates/**
# ⭐ THE PNG PLANE FALLBACKS ARE GONE (Sep 6, 2026). They had grown to 709 files and 305 MB
# — 58% of everything this site deployed — and not one was ever fetched: they exist only for
# a browser that cannot decode WebP, and such a browser cannot run this book at all (WebGL).
# gen/build.mjs now deletes each png as soon as its webp is written; this line is the second
# lock, so a stray one can never ship again. A keepsake set lives in attic/ and is ignored.
plates-vg/*.png
attic
attic/**

# stray unused plate variants
plates-vg/*-old.jpg
plates-vg/*-before*.jpg
plates-vg/*-surface*.jpg


# transition pilots — repo tools, not public pages
wipe-test.html

# ── Sep 25: the workbench stays on this machine, off the public site (Fred) ──────────────
# Study pages and review sheets — local tools (python -m http.server still serves them here).
characters.html
kid3d-test.html
lab-outline.html
# retired runtime scripts: nothing in the book loads them any more (only CSS comments name them)
paint-live.js
pano.js
glitch-live.js
glitch-fields.json
perf-probe.js
# repo scripts
*.py
# the old 1.2 MB social image (og.jpg replaced it) and its source
og.png
og.svg

# ── The cast: ship only what the book draws (Oct 8, 2026) ───────────────
# cast-library/ holds EVERY drawing of the kid, used or not, for future edits. Never deployed.
cast-library
cast-library/**
# Sources and generator by-products that stay in cast/ because gen/ scripts read or write them
# there, but that no page loads: the drawn sheets, the cleaner's .orig baselines, the painted
# sheet and its parts, PNG twins of the webps, and props no page holds any more.
cast/sheets
cast/sheets/**
cast/.orig
cast/.orig/**
cast/*.png
cast/avatar-source.jpg
cast/kid-geometry.json
cast/kid-parts.json
cast/part-*.webp
cast/apple-held.webp
cast/father-arm.webp
# if gen/crayon-to-brush.py is ever re-run it writes these back into cast/; they are library cells
cast/kid-cell-*.webp
cast/kid-detail-*.webp
